<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VaultWare</title>

    <link rel="icon" type="ico" href="~/vaultware_icon.ico" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;600;700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet" />
    <style>
        :root {
            --bg-dark: #0b0f19;
            --glass: rgba(30, 35, 45, 0.95);
            --sidebar-width: 260px;
            --sidebar-width-collapsed: 80px;
            --header-height: 70px;
            --neon-blue: #00d4ff;
            --neon-green: #00ff9d;
            --neon-red: #ff0055;
            --border-color: rgba(255, 255, 255, 0.1);
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--bg-dark);
            background-image: radial-gradient(circle at 50% 0%, #151a26 0%, #0b0f19 80%);
            color: #e6e6e6;
            overflow-x: hidden;
            margin: 0;
            padding: 0;
        }

        /* WRAPPER */
        .wrapper {
            display: flex;
            width: 100%;
            align-items: stretch;
        }

        /* SIDEBAR */
        #sidebar {
            min-width: var(--sidebar-width);
            max-width: var(--sidebar-width);
            background: var(--glass);
            border-right: 1px solid var(--border-color);
            transition: all 0.3s;
            height: 100vh;
            position: fixed;
            z-index: 1000;
            backdrop-filter: blur(10px);
            display: flex;
            flex-direction: column;
        }

            #sidebar.collapsed {
                min-width: var(--sidebar-width-collapsed);
                max-width: var(--sidebar-width-collapsed);
            }

        /* SIDEBAR HEADER (Logo) */
        .sidebar-header {
            height: var(--header-height);
            display: flex;
            align-items: center;
            padding: 0 25px;
            border-bottom: 1px solid var(--border-color);
            overflow: hidden;
            white-space: nowrap;
        }

        .brand-logo {
            font-family: 'Rajdhani', sans-serif;
            font-weight: 700;
            font-size: 1.5rem;
            letter-spacing: 2px;
            color: white;
            display: flex;
            align-items: center;
            gap: 15px;
            text-decoration: none;
            width: 100%;
            transition: all 0.3s; /* Smooth transition for alignment */
        }

        /* --- ALIGNMENT FIX START --- */
        #sidebar.collapsed .sidebar-header {
            padding: 0; /* Remove padding to allow full centering */
            justify-content: center;
        }

        #sidebar.collapsed .brand-logo {
            justify-content: center; /* Force logo to center of 80px width */
            padding: 0;
            gap: 0; /* Remove gap so icon doesn't push off-center */
            width: 100%;
        }
        /* --- ALIGNMENT FIX END --- */

        #sidebar.collapsed .brand-text {
            display: none;
            opacity: 0;
        }

        /* NAVIGATION LINKS */
        .components {
            padding: 20px 0;
            flex-grow: 1;
            overflow-y: auto;
        }

        .nav-link {
            padding: 15px 25px;
            font-family: 'Rajdhani', sans-serif;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255,255,255,0.6);
            display: flex;
            align-items: center;
            gap: 15px;
            transition: all 0.3s;
            white-space: nowrap;
            border-left: 3px solid transparent;
            text-decoration: none;
            height: 55px;
        }

            .nav-link:hover, .nav-link.active {
                color: var(--neon-blue);
                background: rgba(0, 212, 255, 0.05);
                border-left: 3px solid var(--neon-blue);
            }

            .nav-link span.material-symbols-outlined {
                font-size: 24px;
                min-width: 24px;
                display: flex;
                justify-content: center;
                align-items: center;
            }

        #sidebar.collapsed .nav-link {
            padding: 15px 0;
            justify-content: center;
        }

        #sidebar.collapsed .link-text {
            display: none;
        }

        /* SIDEBAR FOOTER */
        .sidebar-footer {
            padding: 20px;
            border-top: 1px solid var(--border-color);
            font-size: 0.8rem;
            color: #666;
            text-align: center;
            white-space: nowrap;
            overflow: hidden;
        }

        #sidebar.collapsed .sidebar-footer {
            display: none;
        }

        /* CONTENT AREA */
        #content {
            width: 100%;
            margin-left: var(--sidebar-width);
            transition: all 0.3s;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

            /* DEFAULT EXPANDED STATE */
            #content.expanded {
                margin-left: var(--sidebar-width-collapsed);
            }

        /* TOP BAR */
        .top-bar {
            height: var(--header-height);
            padding: 0 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(11, 15, 25, 0.8);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 999;
        }

        .btn-toggle {
            background: transparent;
            border: 1px solid var(--border-color);
            color: var(--neon-blue);
            border-radius: 8px;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: 0.3s;
        }

            .btn-toggle:hover {
                background: rgba(0,212,255,0.1);
                box-shadow: 0 0 10px rgba(0,212,255,0.2);
            }

        /* UTILITIES */
        .glass-panel {
            background: var(--glass);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            backdrop-filter: blur(10px);
        }

        .fade-in-up {
            animation: fadeInUp 0.6s ease-out;
        }
        @@keyframes fadeInUp {
            from

        {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        /* WIDGETS */
        #globalScanWidget {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 280px;
            background: rgba(10, 20, 30, 0.98);
            border: 1px solid var(--neon-blue);
            border-radius: 12px;
            padding: 20px;
            z-index: 9999;
            display: none;
            box-shadow: 0 0 20px rgba(0, 212, 255, 0.2);
            animation: slideIn 0.5s ease-out;
        }

        .pulse-dot {
            width: 10px;
            height: 10px;
            background-color: var(--neon-green);
            border-radius: 50%;
            display: inline-block;
            margin-right: 10px;
            box-shadow: 0 0 0 0 rgba(0, 255, 157, 0.7);
            animation: pulse-green 1.5s infinite;
        }
        @@keyframes pulse-green {
            0%

        {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(0, 255, 157, 0.7);
        }

        70% {
            transform: scale(1);
            box-shadow: 0 0 0 10px rgba(0, 255, 157, 0);
        }

        100% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(0, 255, 157, 0);
        }

        }
        @@keyframes slideIn {
            from

        {
            transform: translateX(100%);
        }

        to {
            transform: translateX(0);
        }

        }

        /* MOBILE RESPONSIVENESS */
        @@media (max-width: 768px) {
            #sidebar

        {
            margin-left: calc(-1 * var(--sidebar-width));
        }

        #sidebar.active {
            margin-left: 0;
            min-width: var(--sidebar-width);
        }

            #sidebar.active .brand-text, #sidebar.active .link-text {
                display: inline;
            }

        #content {
            margin-left: 0 !important;
        }

        .top-bar {
            padding: 0 20px;
        }

        }
    </style>
</head>
<body>

    <div class="wrapper">
        <nav id="sidebar" class="collapsed">
            <div class="sidebar-header">
                <a class="brand-logo" href="/">
                    <span class="material-symbols-outlined" style="color:var(--neon-blue); font-size: 2rem;">security</span>
                    <span class="brand-text">VAULTWARE</span>
                </a>
            </div>

            <div class="components">
                <a href="/" class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")">
                    <span class="material-symbols-outlined">dashboard</span> <span class="link-text">Dashboard</span>
                </a>
                <a href="/Home/Advisor" class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "Advisor" ? "active" : "")">
                    <span class="material-symbols-outlined">health_and_safety</span> <span class="link-text">Advisor</span>
                </a>
                <a href="/Home/Reports" class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "Reports" ? "active" : "")">
                    <span class="material-symbols-outlined">description</span> <span class="link-text">Reports</span>
                </a>
                <a href="/Home/Scan" class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "Scan" ? "active" : "")">
                    <span class="material-symbols-outlined">radar</span> <span class="link-text">Scanner</span>
                </a>
                <a href="/Home/Protection" class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "Protection" ? "active" : "")">
                    <span class="material-symbols-outlined">shield</span> <span class="link-text">Protection</span>
                </a>
                <a href="/Home/Quarantine" class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "Quarantine" ? "active" : "")">
                    <span class="material-symbols-outlined">lock</span> <span class="link-text">Vault</span>
                </a>
                <a href="/Home/Speed" class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "Speed" ? "active" : "")">
                    <span class="material-symbols-outlined">speed</span> <span class="link-text">Speed</span>
                </a>
                <a href="/Home/Settings" class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "Settings" ? "active" : "")">
                    <span class="material-symbols-outlined">settings</span> <span class="link-text">Settings</span>
                </a>
            </div>

            <div class="sidebar-footer">
                &copy; 2026 VaultWare
            </div>
        </nav>

        <div id="content" class="expanded">
            <div class="top-bar">
                <button type="button" id="sidebarCollapse" class="btn-toggle">
                    <span class="material-symbols-outlined">menu</span>
                </button>
                <div class="d-flex align-items-center gap-3">
                    <div class="d-none d-sm-block text-end">
                        <small class="text-muted d-block" style="line-height:1;">SYSTEM STATUS</small>
                        <span class="text-success fw-bold" style="letter-spacing:1px;">MONITORING</span>
                    </div>
                    <div style="width:12px; height:12px; background:var(--neon-green); border-radius:50%; box-shadow:0 0 10px var(--neon-green); animation: pulse-green 2s infinite;"></div>
                </div>
            </div>

            <div class="container-fluid p-4">
                <main role="main">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <div id="globalScanWidget">
        <div class="d-flex align-items-center mb-3"><div class="pulse-dot"></div><span class="text-white fw-bold" style="font-family:'Rajdhani'; letter-spacing:1px;">SCAN IN PROGRESS</span></div>
        <div><h3 class="text-white fw-bold m-0" id="widgetCounter">0</h3><small class="text-muted">FILES SCANNED</small></div>
        <div class="mt-2 pt-2 border-top border-secondary"><div class="d-flex justify-content-between text-muted small"><span>Duration:</span><span id="widgetTimer" class="font-monospace text-info">00:00</span></div></div>
        <a href="/Home/Scan" class="stretched-link"></a>
    </div>

    <div class="modal fade" id="securityModal" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-panel" style="background: rgba(20, 0, 5, 0.98); border: 2px solid #ff0055; box-shadow: 0 0 50px rgba(255,0,85,0.4);">
                <div class="modal-header border-0 pb-0"><h5 class="modal-title fw-bold text-danger d-flex align-items-center gap-2"><span class="material-symbols-outlined">warning</span> SECURITY ALERT</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
                <div class="modal-body text-center p-4">
                    <div class="mb-3 text-danger" style="animation: pulse 1s infinite;"><span class="material-symbols-outlined" style="font-size: 5rem;">bug_report</span></div>
                    <h3 class="fw-bold text-white mb-2">THREAT BLOCKED</h3>
                    <p class="text-danger mb-4 fw-bold" id="modalThreatDetails">VaultWare neutralized a threat.</p>
                    <div class="d-grid gap-2 mt-4"><a href="/Home/Quarantine" class="btn btn-danger fw-bold">VIEW IN VAULT</a><button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">DISMISS</button></div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const sidebar = document.getElementById('sidebar');
            const content = document.getElementById('content');
            const toggleBtn = document.getElementById('sidebarCollapse');

            toggleBtn.addEventListener('click', function () {
                if (window.innerWidth <= 768) {
                    sidebar.classList.toggle('active');
                } else {
                    sidebar.classList.toggle('collapsed');
                    content.classList.toggle('expanded');
                }
            });
        });

        var wasScanning = false;
        if ("Notification" in window && Notification.permission !== "granted") Notification.requestPermission();
        function checkSystemStatus() {
            fetch('/Home/GetStatus?t=' + Date.now()).then(r => r.json()).then(data => {
                if (data.isThreat) { document.getElementById('modalThreatDetails').innerText = data.message; new bootstrap.Modal(document.getElementById('securityModal')).show(); new Audio('https://actions.google.com/sounds/v1/alarms/beep_short.ogg').play().catch(() => { }); if (Notification.permission === "granted") new Notification("⚠️ THREAT DETECTED", { body: data.message }); }
            }).catch(e => { });
            fetch('/Home/GetScanProgress?t=' + Date.now()).then(r => r.json()).then(data => {
                var w = document.getElementById('globalScanWidget'); var p = window.location.pathname;
                if (data.isScanning && !p.includes("/Scan")) { w.style.display = 'block'; document.getElementById('widgetCounter').innerText = data.filesScanned.toLocaleString(); document.getElementById('widgetTimer').innerText = data.duration; wasScanning = true; }
                else { w.style.display = 'none'; }
            }).catch(e => { });
        }
        window.addEventListener('load', function () { checkSystemStatus(); setInterval(checkSystemStatus, 1000); });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>