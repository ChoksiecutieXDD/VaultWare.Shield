@{
    ViewData["Title"] = "View Report";
}

<div class="container mt-4 fade-in-up">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <a asp-action="Reports" class="btn btn-outline-light d-flex align-items-center gap-2">
            <span class="material-symbols-outlined">arrow_back</span> Back to List
        </a>
        <h5 class="text-muted font-monospace mb-0">@ViewBag.FileName</h5>
    </div>

    <div class="glass-panel p-0 overflow-hidden d-flex flex-column" style="height: 70vh;">
        <div class="p-3 border-bottom border-secondary d-flex justify-content-between align-items-center" style="background: rgba(0,0,0,0.2);">
            <div class="d-flex align-items-center gap-2">
                <span class="material-symbols-outlined text-info">text_snippet</span>
                <span class="fw-bold">File Content</span>
            </div>
            <button onclick="window.print()" class="btn btn-sm btn-dark text-muted">
                <span class="material-symbols-outlined" style="font-size:16px;">print</span>
            </button>
        </div>

        <div class="p-4 bg-black h-100 overflow-auto">
            <pre class="text-success font-monospace m-0" style="white-space: pre-wrap; font-size: 0.9rem;">@ViewBag.Content</pre>
        </div>
    </div>
</div>