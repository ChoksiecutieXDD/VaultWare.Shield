@model VaultWare.Shield.Models.HealthStatus
@{
    ViewData["Title"] = "Security Advisor";
    var scoreColor = Model.SecurityScore > 80 ? "#00d4ff" : (Model.SecurityScore > 50 ? "#ffaa00" : "#ff0055");
}

<div class="container mt-4 fade-in-up">
    <div class="d-flex align-items-center mb-4">
        <div class="me-3 header-icon-bg" style="display:flex; align-items:center; justify-content:center; width:50px; height:50px; background:rgba(0,212,255,0.1); border-radius:12px; color:var(--neon-blue);">
            <span class="material-symbols-outlined" style="font-size: 32px;">health_and_safety</span>
        </div>
        <div>
            <h2 style="font-weight: 700; letter-spacing: 1px; margin-bottom: 0;">SECURITY <span style="color:var(--neon-blue)">ADVISOR</span></h2>
            <p class="text-muted mb-0 small">Health analysis and recommendations.</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="glass-panel p-4 h-100 text-center d-flex flex-column justify-content-center align-items-center">
                <h5 class="text-white mb-3">SYSTEM HEALTH SCORE</h5>
                <div style="width: 150px; height: 150px; border-radius: 50%; border: 10px solid @scoreColor; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 20px @scoreColor;">
                    <h1 class="display-3 fw-bold mb-0" style="color: @scoreColor;">@Model.SecurityScore</h1>
                </div>
                <h4 class="mt-3 fw-bold" style="color: @scoreColor;">@Model.StatusLabel.ToUpper()</h4>
            </div>
        </div>

        <div class="col-md-8">
            <div class="glass-panel p-4 h-100">
                <h5 class="text-white mb-3">THREATS & SCANS (7 DAYS)</h5>
                <canvas id="trendChart" style="max-height: 250px;"></canvas>
            </div>
        </div>

        <div class="col-12">
            <div class="glass-panel p-4">
                <h5 class="text-white mb-3"><span class="material-symbols-outlined align-middle me-2">recommend</span> RECOMMENDATIONS</h5>
                @if (Model.Recommendations.Count > 0)
                {
                    <ul class="list-group list-group-flush bg-transparent">
                        @foreach (var rec in Model.Recommendations)
                        {
                            <li class="list-group-item bg-transparent text-white border-bottom border-secondary d-flex align-items-start">
                                <span class="material-symbols-outlined text-warning me-3">warning</span>
                                <div>@rec</div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-success text-center p-3">
                        <span class="material-symbols-outlined display-4">check_circle</span>
                        <p class="mt-2">Great job! Your system is fully secured.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // Initialize Graph
    const ctx = document.getElementById('trendChart');
    if(ctx) {
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: @Html.Raw(ViewBag.GraphLabels),
                datasets: [{
                    label: 'Threats Detected',
                    data: @Html.Raw(ViewBag.GraphThreats),
                    borderColor: '#ff0055',
                    backgroundColor: 'rgba(255, 0, 85, 0.2)',
                    tension: 0.4,
                    fill: true
                },
                {
                    label: 'Scans Performed',
                    data: @Html.Raw(ViewBag.GraphScans),
                    borderColor: '#00d4ff',
                    backgroundColor: 'rgba(0, 212, 255, 0.2)',
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { labels: { color: 'white' } }
                },
                scales: {
                    y: { ticks: { color: '#888' }, grid: { color: '#333' } },
                    x: { ticks: { color: '#888' }, grid: { color: '#333' } }
                }
            }
        });
    }
</script>