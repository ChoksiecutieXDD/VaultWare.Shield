@{
    ViewData["Title"] = "Decoys";
}
<div class="container mt-4 fade-in-up">
    <h2 style="font-weight: 700; letter-spacing: 1px;">ACTIVE <span style="color:var(--neon-blue)">DECOYS</span></h2>
    <p class="text-muted mb-4">Hidden honeypots deployed for ransomware interception.</p>

    <div class="glass-panel p-4 mt-4" style="border-left: 4px solid var(--neon-green);">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-white">Primary Trap Node</h5>
            <span class="badge bg-success" style="box-shadow: 0 0 10px var(--neon-green);">ACTIVE MONITORING</span>
        </div>
        <hr style="border-color:rgba(255,255,255,0.2);">
        <p class="text-muted mb-1 small text-uppercase">Path on Disk:</p>
        <code style="display:block; padding: 15px; background: rgba(0,0,0,0.3); border-radius: 8px; color: var(--neon-blue); word-break: break-all; font-family: monospace;">
            @ViewBag.TrapPath
        </code>
        <div class="mt-3 text-warning small">
            ⚠️ <strong>Warning:</strong> Modification of this file will trigger immediate process termination.
        </div>
    </div>
</div>